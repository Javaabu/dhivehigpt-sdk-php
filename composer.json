{
    "name": "javaabu/dhivehigpt-sdk",
    "description": "PHP / Laravel SDK to interact with the DhivehiGPT API",
    "homepage": "https://github.com/Javaabu/dhivehigpt-sdk-php",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "php",
        "sdk",
        "dhivehigpt",
        "api",
        "text-to-speech",
        "tts"
    ],
    "authors": [
        {
            "name": "DhivehiGPT",
            "email": "support@dhivehigpt.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.5 || ^10.5 || ^11.5.3 || ^12.5.8 || ^13.0.3"
    },
    "suggest": {
        "illuminate/support": "Required to use the DhivehiGpt Laravel service provider and facade (^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0)."
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\DhivehiGpt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\DhivehiGpt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\DhivehiGpt\\DhivehiGptServiceProvider"
            ],
            "aliases": {
                "DhivehiGpt": "Javaabu\\DhivehiGpt\\Facades\\DhivehiGpt"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
